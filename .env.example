# Puerto del gateway
PORT_GATEWAY=3000

# Destinos por microservicio (si no se definen, usan BACKEND_URL o sus puertos por defecto 3001..3006)
USUARIOS_URL=http://localhost:3001
CATALOGO_URL=http://localhost:3002
DISPONIBILIDAD_URL=http://localhost:3003
RESERVAS_URL=http://localhost:3004
EVENT_BUS_URL=http://localhost:3005
GRAPHQL_URL=http://localhost:3006

# Clave pública RSA (PEM) para verificar los JWT emitidos por usuarios (D3, RS256).
# Los saltos de línea pueden ir escapados como \n.
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# Tiempo máximo de espera hacia cada microservicio (ms)
GATEWAY_TIMEOUT_MS=15000

# Bandera de publicador activo: event-bus (por defecto) o monolito
PUBLICADOR_ACTIVO=event-bus

